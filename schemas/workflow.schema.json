      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "nodes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "unresolved_calls": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unresolved Calls",
      "type": "array"
    }
  },
  "required": [
    "id",
    "capability"
  ],
  "title": "Workflow",
  "type": "object"
}
