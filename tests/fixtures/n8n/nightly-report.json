[
  {
    "id": "wf-report",
    "name": "Nightly overdue report",
    "nodes": [
      {
        "id": "1", "name": "Every night", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2,
        "position": [0, 0], "parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "0 2 * * *"}]}}
      },
      {
        "id": "2", "name": "Read overdue invoices", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5,
        "position": [200, 0], "parameters": {"operation": "read", "documentId": {"__rl": true, "value": "sheet-1", "mode": "list"}},
        "credentials": {"googleSheetsOAuth2Api": {"id": "c4", "name": "Finance sheets"}}
      },
      {
        "id": "3", "name": "Remove paid rows", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5,
        "position": [400, 0], "parameters": {"operation": "delete", "documentId": {"__rl": true, "value": "sheet-1", "mode": "list"}},
        "credentials": {"googleSheetsOAuth2Api": {"id": "c4", "name": "Finance sheets"}}
      },
      {
        "id": "4", "name": "Post summary", "type": "n8n-nodes-base.slack", "typeVersion": 2.2,
        "position": [600, 0], "parameters": {"resource": "message", "operation": "post", "channel": "#finance"},
        "credentials": {"slackApi": {"id": "c1", "name": "Slack finance bot"}}
      }
    ],
    "connections": {
      "Every night": {"main": [[{"node": "Read overdue invoices", "type": "main", "index": 0}]]},
      "Read overdue invoices": {"main": [[{"node": "Remove paid rows", "type": "main", "index": 0}]]},
      "Remove paid rows": {"main": [[{"node": "Post summary", "type": "main", "index": 0}]]}
    }
  }
]
