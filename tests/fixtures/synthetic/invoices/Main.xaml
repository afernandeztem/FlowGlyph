<Activity mc:Ignorable="sap sap2010" x:Class="Main" this:Main.in_Threshold="10000"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:this="clr-namespace:"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="Path of the invoice PDF." Name="in_InvoicePath" Type="InArgument(x:String)" />
    <x:Property Name="in_Threshold" Type="InArgument(x:Decimal)" />
    <x:Property Name="out_InvoiceId" Type="OutArgument(x:String)" />
  </x:Members>
  <Sequence DisplayName="Process invoice" sap2010:Annotation.AnnotationText="Validate an invoice and book it, asking for approval above the threshold." sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:LogMessage Level="Info" Message="[&quot;Start&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
    <ui:InvokeWorkflowFile DisplayName="Validate vendor" WorkflowFileName="Steps\ValidateVendor.xaml" sap2010:WorkflowViewState.IdRef="Invoke_1" />
    <If Condition="[amount &gt; in_Threshold]" DisplayName="Above threshold?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <ui:InvokeWorkflowFile DisplayName="Request approval" WorkflowFileName="Steps\RequestApproval.xaml" sap2010:WorkflowViewState.IdRef="Invoke_2" />
      </If.Then>
    </If>
    <ui:InvokeWorkflowFile DisplayName="Book invoice" WorkflowFileName="Steps\BookInvoice.xaml" sap2010:WorkflowViewState.IdRef="Invoke_3" />
    <ui:InvokeWorkflowFile DisplayName="Archive" WorkflowFileName="Steps\Missing.xaml" sap2010:WorkflowViewState.IdRef="Invoke_4" />
  </Sequence>
</Activity>
