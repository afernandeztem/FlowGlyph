<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic SAP Gateway service written for FlowGlyph's tests. -->
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns:sap="http://www.sap.com/Protocols/SAPData">
  <edmx:DataServices m:DataServiceVersion="2.0">
    <Schema Namespace="ZSUPPLIER_INVOICE_SRV" xml:lang="en" sap:schema-version="1" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
      <EntityType Name="SupplierInvoiceType" sap:label="Supplier invoice" sap:content-version="1">
        <Key>
          <PropertyRef Name="SupplierInvoice"/>
          <PropertyRef Name="FiscalYear"/>
        </Key>
        <Property Name="SupplierInvoice" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Invoice document" sap:creatable="false" sap:updatable="false"/>
        <Property Name="FiscalYear" Type="Edm.String" Nullable="false" MaxLength="4" sap:label="Fiscal year" sap:creatable="false" sap:updatable="false"/>
        <Property Name="CompanyCode" Type="Edm.String" Nullable="false" MaxLength="4" sap:label="Company code"/>
        <Property Name="InvoicingParty" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Supplier"/>
        <Property Name="SupplierInvoiceIDByInvcgParty" Type="Edm.String" MaxLength="16" sap:label="Supplier's invoice reference"/>
        <Property Name="InvoiceGrossAmount" Type="Edm.Decimal" Precision="14" Scale="3" sap:label="Gross amount"/>
        <Property Name="DocumentCurrency" Type="Edm.String" MaxLength="5" sap:label="Currency"/>
        <Property Name="PostingDate" Type="Edm.DateTime" Precision="0" sap:label="Posting date"/>
        <Property Name="IsBlocked" Type="Edm.Boolean" sap:label="Blocked for payment" sap:creatable="false"/>
      </EntityType>
      <EntityType Name="SupplierType" sap:label="Supplier">
        <Key>
          <PropertyRef Name="Supplier"/>
        </Key>
        <Property Name="Supplier" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Supplier"/>
        <Property Name="SupplierName" Type="Edm.String" MaxLength="80" sap:label="Name"/>
        <Property Name="SupplierID" Type="Edm.Guid" sap:label="Technical ID"/>
      </EntityType>
      <EntityContainer Name="ZSUPPLIER_INVOICE_SRV_Entities" m:IsDefaultEntityContainer="true">
        <EntitySet Name="SupplierInvoice" EntityType="ZSUPPLIER_INVOICE_SRV.SupplierInvoiceType" sap:creatable="true" sap:updatable="true" sap:deletable="false" sap:content-version="1"/>
        <EntitySet Name="Supplier" EntityType="ZSUPPLIER_INVOICE_SRV.SupplierType" sap:creatable="false" sap:updatable="false" sap:deletable="false" sap:content-version="1"/>
        <FunctionImport Name="Release" ReturnType="ZSUPPLIER_INVOICE_SRV.SupplierInvoiceType" EntitySet="SupplierInvoice" m:HttpMethod="POST" sap:label="Release blocked invoice">
          <Parameter Name="SupplierInvoice" Type="Edm.String" Mode="In" MaxLength="10"/>
          <Parameter Name="FiscalYear" Type="Edm.String" Mode="In" MaxLength="4"/>
        </FunctionImport>
        <FunctionImport Name="GetDuplicateCandidates" ReturnType="Collection(ZSUPPLIER_INVOICE_SRV.SupplierInvoiceType)" EntitySet="SupplierInvoice" m:HttpMethod="GET" sap:label="Find possible duplicates">
          <Parameter Name="InvoicingParty" Type="Edm.String" Mode="In" MaxLength="10"/>
          <Parameter Name="InvoiceGrossAmount" Type="Edm.Decimal" Mode="In" Nullable="true"/>
        </FunctionImport>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
